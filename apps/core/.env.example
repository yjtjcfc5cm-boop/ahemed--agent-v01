# Copy to apps/core/.env and fill in. Never commit .env.

# Shared secret the mobile app sends as "Authorization: Bearer <APP_TOKEN>".
# Use a long random value. Must equal EXPO_PUBLIC_APP_TOKEN in apps/mobile/.env.
APP_TOKEN=change-me-to-a-long-random-string

# Anthropic model provider (Core only; the app never sees this).
ANTHROPIC_API_KEY=
MODEL_NAME=claude-opus-5-5

# Network: 0.0.0.0 so the phone on the same Wi-Fi can reach the Core.
HOST=0.0.0.0
PORT=8787

# All agent files live here (relative to apps/core). Uploads go to <WORKSPACE_ROOT>/inbox.
WORKSPACE_ROOT=./workspace

# SQLite database file (relative to apps/core).
DB_FILE=./ahmed-core.db

# v0.2 (optional): USD price per 1M tokens for MODEL_NAME. Both are needed for cost_usd
# to appear in results and in the task event stream; unset = tokens recorded, cost omitted.
MODEL_PRICE_INPUT_PER_1M=
MODEL_PRICE_OUTPUT_PER_1M=
